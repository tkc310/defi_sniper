# .env.example をコピーして .env を作成してください (.env は git 管理外)
#   cp .env.example .env
# Bun は実行時にカレントディレクトリの .env を自動で読み込みます。

# 利用する DEX プリセット (env/<DEX>.env を読み込む): pancake | bakery | pangolin
DEX=pancake

# swap 元トークン (買い: これで払う / 売り: これを受け取る)
#   BUSD: 0xe9e7cea3dedca5984780bafc599bd69add087d56
#   USDT(BUSD-T): 0x55d398326f99059ff775485246999027b3197955
#   WBNB: 0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
ADDRESS_FROM=""
# swap 先トークン (狙うトークン)
ADDRESS_TO=""

# 1 回の購入で使う ADDRESS_FROM の数量 (小数可)
AMOUNT="50"
# buy:multiple で 1 回あたりに使う数量 (購入上限があるトークン向け)
MULTIPLE_AMOUNT="1"

# 取引期限 (分)
DEADLINE_MIN=25

# 売買のガス設定 (price は gwei)
#   veryhigh: limit 10000000 / price 100~300
#   high:     limit 10000000 / price 50
#   mid:      limit 10000000 / price 10
#   low:      limit 10000000 / price 5
#   test:     limit 170000   / price 5
TRADE_GAS_LIMIT=10000000
TRADE_GAS_PRICE="5"

# approve のガス設定 (price は gwei)
#   high: 500000 / 50, mid: 300000 / 25, low: 250000 / 5
APPROVE_GAS_LIMIT=250000
APPROVE_GAS_PRICE="10"

# subscribe:pair-created で検出したいシンボル (カンマ区切り, 正規表現可)
WATCH_SYMBOLS=""

# 約定通知用の Slack 互換 Webhook (任意)
WEBHOOK_URL=""

# 1 にするとトランザクションを送信せず内容だけ表示する
DRY_RUN=0

# ウォレットの秘密鍵 (必須)
# ⚠️ bot 専用の新規ウォレットを使い、必要最小限の資金だけ入れてください
PRIVATE_KEY=""
