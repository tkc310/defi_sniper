# survey:* 用の設定。API キーは .env に BITQUERY_API_KEY として書くこと

# survey:tx — 対象トークンと期間
SURVEY_TOKEN=""
SURVEY_DATE_FROM="2021-06-06T14:00:00+00:00"
SURVEY_DATE_TO="2021-06-07T14:35:00+00:00"
